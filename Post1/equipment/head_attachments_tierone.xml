<Equipment>

	
	<HelmetNVG name="GPNVG_01" inventoryBinding="HelmetNVG" unlockCost="20"
		tooltip="@nvg_nswdg_gpnvg18_name"
		description="@nvg_nswdg_gpnvg18_desc"
		img="data/models/humans/attachments/gpnvg_ui.dds"
	>


		<MobilityModifiers moveSpeedModifierPercent="0" turnSpeedModifierPercent="-3" />
		<ConcealmentModifier add="0" />

		<!-- fov params overwrite the base ones -->
		<ModifiableParams
			fovDegrees="100"
			fovRadiusMeters="0.42"
			fovRangeMeters="999"
		/>

		<!-- this is shown for daylight missions -->
		<RenderObject3D model="data/models/humans/attachments/gpnvg_up.khm"
			diffuseTex="data/models/humans/attachments/gpnvg.dds" attachSlot="nvg">
			<Specular shininess="8" intensity="1.3" />
		</RenderObject3D>

		<!-- this is shown in night missions -->
		<RenderObject3D model="data/models/humans/attachments/gpnvg.khm"
			diffuseTex="data/models/humans/attachments/gpnvg.dds" attachSlot="nvg">
			<Specular shininess="8" intensity="1.3" />
		</RenderObject3D>
		<RenderObject3D model="data/models/humans/attachments/gpnvg_lights.khm"
			diffuseTex="data/textures/fx/light_flare_01.dds" diffuseColor="91deff" blendMode="add"
			attachSlot="nvg">
		</RenderObject3D>
	</HelmetNVG>

	<Bind eqp="GPNVG_02">
		<to name="BlackOps" />
	</Bind>
	<HelmetNVG name="GPNVG_02" inventoryBinding="HelmetNVG" unlockCost="20"
		tooltip="@nvg_nswdg_gpnvg18_name"
		description="@nvg_nswdg_gpnvg18_desc"
		img="data/models/humans/attachments/gpnvg_ui.dds"
	>

		<MobilityModifiers moveSpeedModifierPercent="0" turnSpeedModifierPercent="-3" />
		<ConcealmentModifier add="0" />

		<!-- fov params overwrite the base ones -->
		<ModifiableParams
			fovDegrees="100"
			fovRadiusMeters="0.42"
			fovRangeMeters="999"
		/>

		<!-- this is shown for daylight missions -->
		<RenderObject3D model="data/models/humans/attachments/gpnvg_up_2.khm"
			diffuseTex="data/models/humans/attachments/gpnvg.dds" attachSlot="nvg">
			<Specular shininess="8" intensity="1.3" />
		</RenderObject3D>

		<!-- this is shown in night missions -->
		<RenderObject3D model="data/models/humans/attachments/gpnvg_2.khm"
			diffuseTex="data/models/humans/attachments/gpnvg.dds" attachSlot="nvg">
			<Specular shininess="8" intensity="1.3" />
		</RenderObject3D>
		<RenderObject3D model="data/models/humans/attachments/gpnvg_lights.khm"
			diffuseTex="data/textures/fx/light_flare_01.dds" diffuseColor="91deff" blendMode="add"
			attachSlot="nvg">
		</RenderObject3D>
	</HelmetNVG>
</Equipment>
